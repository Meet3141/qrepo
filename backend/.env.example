# Copy to backend/.env and fill in real values. Never commit .env.

# --- Core ---
DATABASE_URL=postgresql://user:password@localhost:5432/qrepo
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI (backend only; never expose to the frontend) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Required. Set to a current Gemini model id from your Google AI Studio console.
GEMINI_MODEL=

# Optional (defaults shown)
# GEMINI_TEMPERATURE=0.4
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_RETRIES=2            # hard-capped at 2
# GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
# GEMINI_RETRY_MAX_DELAY_SECONDS=8.0
# AI_CONTEXT_MAX_CHARS=12000
